@model RuleBuilderViewModel
@{
    ViewData["Title"] = Model.Title;
}

<h1 class="h3 mb-3">@Model.Title</h1>

@* Messages of the server and of ICustomStrategyFactory.Validate, as they are (P4-U9). *@
@if (Model.Problems.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <p class="mb-0">@Model.ProblemsHeading</p>
        <ul class="mb-0 mt-2">
            @foreach (var problem in Model.Problems)
            {
                <li>@problem</li>
            }
        </ul>
    </div>
}

@if (Model.HasFieldErrors)
{
    <div class="alert alert-warning" role="alert">
        <p class="mb-0">@RuleBuilderViewModel.FormatHeading</p>
    </div>
}

<noscript>
    <div class="alert alert-info">@RuleBuilderViewModel.NoScriptNote</div>
</noscript>

<form id="rule-builder" class="qb-panel" method="post" action="@Model.SaveUrl" asp-antiforgery="true">
    @if (Model.IsEdit)
    {
        <input type="hidden" name="@CustomStrategyForm.IdKey" value="@Model.Form.Id" />
    }

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label class="form-label" for="name">Name</label>
            <input class="form-control" type="text" id="name" name="@CustomStrategyForm.NameKey" value="@Model.Form.Name"
                   readonly="@Model.IsEdit" aria-describedby="@(Model.IsEdit ? "name-help" : null)" />
            @if (Model.IsEdit)
            {
                <div class="form-text" id="name-help">@RuleBuilderViewModel.NameReadOnlyNote</div>
            }
        </div>
        <div class="col-12">
            <label class="form-label" for="description">Description</label>
            <textarea class="form-control" id="description" name="@CustomStrategyForm.DescriptionKey" rows="2">@Model.Form.Description</textarea>
            <div class="form-text">Optional.</div>
        </div>
    </div>

    @if (Model.IsEdit)
    {
        <p class="alert alert-secondary small mt-3 mb-0">@RuleBuilderViewModel.PermalinkNote</p>
    }

    @foreach (var rule in new[] { Model.Entry, Model.Exit })
    {
        <section class="mt-4" data-rule data-min="@rule.MinConditions" data-max="@rule.MaxConditions"
                 aria-labelledby="@rule.IdPrefix-title">
            <h2 class="h5" id="@rule.IdPrefix-title">@rule.Title</h2>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <label class="form-label mb-0" for="@rule.IdPrefix-combinator">@rule.Verb</label>
                <select class="form-select w-auto @(rule.CombinatorError is null ? "" : "is-invalid")"
                        id="@rule.IdPrefix-combinator" name="@rule.CombinatorName">
                    @foreach (var option in RuleBuilderOptions.Combinators)
                    {
                        <option value="@option.Value" selected="@(option.Value == rule.Combinator)">@option.Label</option>
                    }
                </select>
                @if (rule.CombinatorError is not null)
                {
                    <div class="invalid-feedback">@rule.CombinatorError</div>
                }
            </div>

            <div class="d-flex flex-column gap-3" data-condition-list>
                @foreach (var row in rule.Rows)
                {
                    <partial name="_ConditionRow" model="row" />
                }
            </div>
            <template data-condition-template>
                <partial name="_ConditionRow" model="rule.Template" />
            </template>

            <button type="button" class="btn btn-sm btn-outline-secondary mt-3" data-add-condition data-js-only hidden>Add condition</button>
            <div class="form-text" aria-live="polite" aria-atomic="true"><span data-condition-count>@rule.ConditionCount</span>@rule.CountSuffix</div>
        </section>
    }

    <div class="d-flex flex-wrap gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Save strategy</button>
        <a class="btn btn-outline-secondary" href="@Model.CancelUrl">Cancel</a>
    </div>
</form>

@if (Model.DeleteUrl is not null)
{
    <form class="mt-3" method="post" action="@Model.DeleteUrl" asp-antiforgery="true" data-confirm="@Model.DeleteConfirmation">
        <button type="submit" class="btn btn-outline-danger">Delete</button>
    </form>
}

@section Scripts {
    <script type="module" src="~/js/rule-builder.js" asp-append-version="true"></script>
}
